# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# Run `make env-sync` to create .env from this file without overwriting existing
# ──────────────────────────────────────────────────────────────────────────────

SERVICE=aips-recs-zenml-mlops

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ZENML_ARTIFACT_BUCKET=aips-recs-zenml-artifacts
ZENML_CHECKPOINT_BUCKET=aips-recs-zenml-checkpoints
ZENML_DATA_BUCKET=aips-recs-zenml-data
ZENML_PREDICTIONS_BUCKET=aips-recs-zenml-predictions
ZENML_ECR_REPOSITORY=aips-recs-zenml

# ── DASK ─────────────────────────────────────────────────────────────────────
DASK_SCHEDULER_PORT=8786
DASK_DASHBOARD_PORT=8787

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_PORT=5000
MLFLOW_TRACKING_URI="http://localhost:$(MLFLOW_TRACKING_PORT)"
MLFLOW_TRACKING_USERNAME=mlflow-ui
MLFLOW_TRACKING_PASSWORD=mlflow-ui

# ── Ops DB (shared MySQL for MLflow + ZenML) ─────────────────────────────────
OPS_DB_ROOT_PASSWORD=opsroot
OPS_DB_USER=ops
OPS_DB_PASSWORD=ops

# Database names — each service gets its own logical database
MLFLOW_DB_NAME=mlflow
ZENML_DB_NAME=zenml

# Where MLflow stores artifacts (local path or s3:// URI)
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts

# ── ZenML ─────────────────────────────────────────────────────────────────────
# Local artifact store path (used by infra/local/setup_stacks.sh)
ZENML_ARTIFACT_STORE_PATH=./data/artifact_store

# ZenML server default admin credentials (used by docker-compose + make zenml-connect)
# ZENML_SERVER_AUTO_ACTIVATE=1 creates the admin account on first boot
ZENML_SERVER_AUTO_ACTIVATE=1
ZENML_SERVER_PORT=8237
ZENML_DEFAULT_USER_NAME=default
ZENML_DEFAULT_USER_PASSWORD=zenml
ZENML_SERVER_URI="http://$(ZENML_DEFAULT_USER_NAME):$(ZENML_DEFAULT_USER_PASSWORD)@localhost:$(ZENML_SERVER_PORT)"

# IAM role/policy names for ZenML SageMaker execution
ZENML_EXEC_ROLE_NAME=aips-recs-zenml-execution-role
ZENML_EXEC_ROLE_POLICY_NAME=aips-recs-zenml-execution-policy