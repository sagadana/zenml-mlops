# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# Run `make env-setup` to create .env from this file only if .env is missing
# ──────────────────────────────────────────────────────────────────────────────

SERVICE=zenml-mlops
ENVIRONMENT=local

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=secret
ZENML_ARTIFACT_BUCKET=zenml-artifacts
ZENML_CHECKPOINT_BUCKET=zenml-checkpoints
ZENML_DATA_BUCKET=zenml-data
ZENML_PREDICTIONS_BUCKET=zenml-predictions
ZENML_ECR_REPOSITORY=zenml
ZENML_BATCH_DDB_TABLE_NAME=zenml-batch
ZENML_BATCH_DDB_PARTITION_KEY_NAME=id

# ── SeaweedFS (local S3-compatible artifact store) ───────────────────────────
SEAWEEDFS_ACCESS_KEY_ID=admin
SEAWEEDFS_SECRET_ACCESS_KEY=secret
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_ADMIN_PORT=23646
SEAWEEDFS_S3_BUCKETS=$(ZENML_ARTIFACT_BUCKET),$(ZENML_CHECKPOINT_BUCKET),$(ZENML_DATA_BUCKET),$(ZENML_PREDICTIONS_BUCKET)
# ----- To be used outside docker containers (e.g., Local client) -----
SEAWEEDFS_S3_ENDPOINT=http://localhost:$(SEAWEEDFS_S3_PORT)
# ----- To be used within docker containers (e.g., Zenml server) -----
SEAWEEDFS_S3_INTERNAL_ENDPOINT=http://host.docker.internal:$(SEAWEEDFS_S3_PORT)

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_PORT=5000
# ----- To be used outside docker containers (e.g., Local client) -----
MLFLOW_TRACKING_URI=http://localhost:$(MLFLOW_TRACKING_PORT)
# ----- To be used within docker containers (e.g., Zenml server) -----
MLFLOW_TRACKING_INTERNAL_URI=http://host.docker.internal:$(MLFLOW_TRACKING_PORT)
MLFLOW_TRACKING_USERNAME=mlflow-ui
MLFLOW_TRACKING_PASSWORD=mlflow-ui
MLFLOW_ARTIFACT_URI=s3://$(ZENML_ARTIFACT_BUCKET)/mlflow

# ── Ops DB (shared MySQL for MLflow + ZenML) ─────────────────────────────────
OPS_DB_ROOT_PASSWORD=opsroot
OPS_DB_USER=ops
OPS_DB_PASSWORD=ops
OPS_DB_HOST=localhost
OPS_DB_PORT=3306
OPS_DB_URI=mysql+pymysql://${OPS_DB_USER}:${OPS_DB_PASSWORD}@${OPS_DB_HOST}:${OPS_DB_PORT}

# Database names — each service gets its own logical database
MLFLOW_DB_NAME=mlflow
ZENML_DB_NAME=zenml
OPTUNA_DB_NAME=optuna

# ── ZenML ─────────────────────────────────────────────────────────────────────
ZENML_LOCAL_STACK_NAME=local_docker_stack
ZENML_LOCAL_ORCHESTRATOR_NAME=local_docker_orchestrator
ZENML_LOCAL_ARTIFACT_STORE_NAME=local_s3_store_docker
ZENML_LOCAL_S3_SECRET_NAME=local_s3_auth_secret
ZENML_LOCAL_EXPERIMENT_TRACKER_NAME=mlflow_tracker
ZENML_LOCAL_MODEL_REGISTRY_NAME=mlflow_model_registry
ZENML_LOCAL_DATA_VALIDATOR_NAME=evidently_data_validator
ZENML_LOCAL_CONTAINER_REGISTRY_NAME=local_container_registry
# Local artifact store path + S3 client config (used by infra/local/setup_stacks.sh)
ZENML_ARTIFACT_STORE_PATH=s3://$(ZENML_ARTIFACT_BUCKET)/
# Optional explicit endpoint override (auto-derived from ZENML_HOST_IP if empty)
ZENML_ARTIFACT_STORE_ENDPOINT_URL=
# Optional host LAN IP override (auto-detected if empty)
ZENML_HOST_IP=
# Service account for REST API access (used by infra/setup_service_account.sh)
# Set this to create a service account and API key during stack setup
ZENML_SERVICE_ACCOUNT_NAME=zenml-automation
# ── ZenML (Server) ─────────────────────────────────────────────────────────────────────
# ZenML server default admin credentials (used by docker-compose + make zenml-connect)
# ZENML_SERVER_AUTO_ACTIVATE=1 creates the admin account on first boot
ZENML_SERVER_AUTO_ACTIVATE=1
ZENML_LOGGING_VERBOSITY=INFO
ZENML_SERVER_PORT=8237
ZENML_DEFAULT_USER_NAME=default
ZENML_DEFAULT_USER_PASSWORD=zenml
ZENML_SERVER_JWT_SECRET_KEY=change-this-jwt-secret
# ----- To be used outside docker containers (e.g., Local client) -----
ZENML_SERVER_URI=http://localhost:$(ZENML_SERVER_PORT)
# ----- To be used within docker containers (e.g., Zenml server) -----
ZENML_SERVER_INTERNAL_URI=http://host.docker.internal:$(ZENML_SERVER_PORT)

# ── ZenML (Infra) ─────────────────────────────────────────────────────────────────────
# IAM role/policy names for ZenML SageMaker execution
ZENML_EXEC_ROLE_NAME=zenml-execution-role
ZENML_EXEC_ROLE_POLICY_NAME=zenml-execution-policy
ZENML_SCHEDULER_ROLE_NAME=zenml-scheduler-role
ZENML_SCHEDULER_ROLE_POLICY_NAME=zenml-scheduler-policy

# Local Docker container registry port (registry:2 service in docker-compose)
LOCAL_REGISTRY_PORT=5001

# Optuna
OPTUNA_STORAGE_URI=mysql+pymysql://${OPS_DB_USER}:${OPS_DB_PASSWORD}@host.docker.internal:${OPS_DB_PORT}/${OPTUNA_DB_NAME}
