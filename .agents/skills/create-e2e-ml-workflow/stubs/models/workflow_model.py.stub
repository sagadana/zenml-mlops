"""
Model wrapper class for <WorkflowName>.
Holds trained weights and provides predict() / batch_predict() methods.
Serialized via cloudpickle by <ModelClassName>Materializer.
"""
from __future__ import annotations

from dataclasses import dataclass, field

import numpy as np
import pandas as pd


@dataclass
class <ModelClassName>:
    """
    Trained <WorkflowName> model.

    Add algorithm-specific weight arrays as fields, e.g.:
      user_factors: np.ndarray   # (n_users × factors)
      item_factors: np.ndarray   # (n_items × factors)
    """
    user_factors: np.ndarray
    item_factors: np.ndarray
    user_encoder: pd.Series        # raw ID → dense index
    item_encoder: pd.Series        # raw ID → dense index
    factors: int
    model_version: str = "unknown"

    _item_decoder: pd.Series | None = field(default=None, repr=False, compare=False)

    def __post_init__(self) -> None:
        if self.user_factors.ndim != 2:
            raise ValueError("user_factors must be 2D")
        if self.item_factors.ndim != 2:
            raise ValueError("item_factors must be 2D")
        if self.user_factors.shape[1] != self.item_factors.shape[1]:
            raise ValueError("user_factors and item_factors must have matching factors")

    @property
    def n_users(self) -> int:
        return int(self.user_factors.shape[0])

    @property
    def n_items(self) -> int:
        return int(self.item_factors.shape[0])

    @property
    def item_decoder(self) -> pd.Series:
        if self._item_decoder is None:
            self._item_decoder = pd.Series(
                self.item_encoder.index.values, index=self.item_encoder.values
            )
        return self._item_decoder

    def predict(self, user_id: int, top_k: int = 10) -> list[dict]:
        """
        Return top-K recommendations for a single user.
        Returns list of {"item_id": int, "score": float}, descending by score.
        Raises KeyError for unknown user_id.
        """
        if user_id not in self.user_encoder.index:
            raise KeyError(f"Unknown user_id: {user_id}")

        user_idx = int(self.user_encoder[user_id])
        scores = self.item_factors @ self.user_factors[user_idx]
        top_item_idxs = np.argpartition(scores, -top_k)[-top_k:]
        top_item_idxs = top_item_idxs[np.argsort(scores[top_item_idxs])[::-1]]

        return [
            {"item_id": int(self.item_decoder[idx]), "score": float(scores[idx])}
            for idx in top_item_idxs
        ]

    def batch_predict(self, user_ids: np.ndarray, top_k: int = 10) -> list[dict]:
        """
        Return top-K recommendations for a batch of users.
        Returns [{"user_id": int, "recommendations": [{"item_id": int, "score": float}]}, ...].
        """
        results = []
        for uid in user_ids:
            try:
                results.append({"user_id": int(uid), "recommendations": self.predict(uid, top_k)})
            except KeyError:
                results.append({"user_id": int(uid), "recommendations": []})
        return results

    def __repr__(self) -> str:
        return (
            f"<ModelClassName>(n_users={self.n_users}, n_items={self.n_items}, factors={self.params.factors}, "
            f"version={self.version!r})"
        )
