"""ZenML step: train_<algo> — full training loop with checkpoint resume."""
from __future__ import annotations

import logging
from typing import Annotated

import numpy as np
import pandas as pd
from zenml import get_step_context, log_metadata, step
from zenml.client import Client

from helpers.checkpointing import (
    clean_run_checkpoints,
    get_zenml_step_checkpoint_path,
    load_latest_checkpoint,
    save_checkpoint,
)

logger = logging.getLogger(__name__)
experiment_tracker = Client().active_stack.experiment_tracker


@step(
    enable_cache=False,
    experiment_tracker=experiment_tracker.name if experiment_tracker else None,
)
def train_<algo>(
    train_data: pd.DataFrame,
    val_data: pd.DataFrame,
    best_hyperparams: dict,
    checkpoint_path: str,
    n_workers: int = 4,
    eval_at_k: int = 10,
    eval_every_n_epochs: int = 1,
    checkpoint_every_n_epochs: int = 1,
    seaweedfs_s3_internal_endpoint: str | None = None,
    zenml_local_s3_secret_name: str | None = None,
) -> tuple[
    Annotated[np.ndarray, "primary_factors"],
    Annotated[np.ndarray, "secondary_factors"],
    Annotated[dict, "training_states"],
]:
    """
    Train the model for all epochs in a single step with automatic checkpoint
    resume.

    Checkpointing protocol:
      epoch_{n:04d}_primary.npy    ← primary factors after epoch n
      epoch_{n:04d}_secondary.npy  ← secondary factors after epoch n
      epoch_{n:04d}.done           ← written LAST (atomic commit marker)

    On resume: load_latest_checkpoint() finds the latest .done marker and
    resumes from that epoch, warm-starting the model.

    Customize:
    - Replace 'primary_factors'/'secondary_factors' with algorithm-specific names
    - Implement the per-epoch update logic for your algorithm
    - Adjust checkpoint_path namespace and factor shapes as needed
    """
    training_checkpoint_path = get_zenml_step_checkpoint_path(
        checkpoint_path, namespace="training"
    )

    # --- Resume from checkpoint if available ---
    latest_epoch, primary_factors, secondary_factors = load_latest_checkpoint(
        training_checkpoint_path,
        seaweedfs_s3_internal_endpoint=seaweedfs_s3_internal_endpoint,
    )
    start_epoch = latest_epoch if primary_factors is not None else 0

    if primary_factors is None:
        raise ValueError(
            "Customize train_<algo>(): initialize primary/secondary factors for "
            "your algorithm when no checkpoint exists."
        )

    n_iter = int(best_hyperparams.get("n_iter", 10))
    training_states = {}

    for epoch in range(start_epoch, n_iter):
        # Implement one epoch of your algorithm here
        raise ValueError(
            f"Customize train_<algo>(): implement epoch {epoch} update logic."
        )

        if (epoch + 1) % checkpoint_every_n_epochs == 0:
            save_checkpoint(
                epoch=epoch + 1,
                primary=primary_factors,
                secondary=secondary_factors,
                base_path=training_checkpoint_path,
                seaweedfs_s3_internal_endpoint=seaweedfs_s3_internal_endpoint,
            )

        if (epoch + 1) % eval_every_n_epochs == 0:
            # Evaluate and log metrics
            raise ValueError(
                "Customize train_<algo>(): implement evaluation logic per epoch."
            )

    run_id = str(get_step_context().pipeline_run.id)
    clean_run_checkpoints(
        f"{training_checkpoint_path}/{run_id}",
        seaweedfs_s3_internal_endpoint=seaweedfs_s3_internal_endpoint,
    )

    return primary_factors, secondary_factors, training_states
