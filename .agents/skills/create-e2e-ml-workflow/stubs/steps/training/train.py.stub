"""ZenML step: train_model — distributed training with epoch-level checkpointing."""
from __future__ import annotations

import logging
import os
import uuid
from typing import Annotated, Tuple

import dask_expr as dd
import numpy as np
import pandas as pd
from zenml import get_step_context, step

from helpers.checkpointing import load_latest_checkpoint, save_checkpoint
from helpers.dask_cluster import get_dask_client, get_client_mode_from_config

logger = logging.getLogger(__name__)


def _initialize_factors(n_users: int, n_items: int, rank: int) -> tuple[np.ndarray, np.ndarray]:
    rng = np.random.default_rng(42)
    user_factors = (rng.standard_normal((n_users, rank)) * 0.01).astype(np.float32)
    item_factors = (rng.standard_normal((n_items, rank)) * 0.01).astype(np.float32)
    return user_factors, item_factors


def _build_partition_matrices(train_pd: pd.DataFrame, n_users: int, n_items: int) -> list[np.ndarray]:
    matrix = np.zeros((n_users, n_items), dtype=np.float32)
    matrix[train_pd["user_idx"].values, train_pd["item_idx"].values] = train_pd["rating"].values
    return [matrix]


def _run_epoch_update(
    partitions: list[np.ndarray],
    user_factors: np.ndarray,
    item_factors: np.ndarray,
    best_hyperparams: dict,
    client,
) -> tuple[np.ndarray, np.ndarray]:
    """
    Replace with algorithm-specific distributed epoch update.
    Must return updated (user_factors, item_factors).
    """
    raise ValueError(
        "Customize _run_epoch_update() for your workflow. "
        "Use client.submit(...) and gather updated factor blocks."
    )


@step(enable_cache=True)
def train_model(
    train_data: dd.DataFrame,
    val_data: dd.DataFrame,
    best_hyperparams: dict,
    checkpoint_path: str = "./checkpoints",
    n_dask_partitions: int = 4,
    checkpoint_val_every_n_epochs: int = 5,
) -> Tuple[
    Annotated[np.ndarray, "user_factors"],
    Annotated[np.ndarray, "item_factors"],
]:
    """
    Train with distributed Dask workers and epoch-level checkpointing.

    RESUMABILITY:
      - First run: initializes weights randomly, trains from epoch 0
      - Restart after failure: loads latest .done checkpoint, resumes from next epoch
      - ZenML cache (enable_cache=True): skips entirely if code + inputs unchanged

    To resume a failed run: re-run the exact same command. No manual steps needed.
    """
    n_iter = int(best_hyperparams.get("n_iter", 15))

    # Scope checkpoints to this pipeline run so parallel runs don't collide
    try:
        run_id = get_step_context().pipeline_run.id
    except Exception:
        run_id = str(uuid.uuid4())[:8]
    run_checkpoint_path = f"{checkpoint_path}/{run_id}"

    # Load checkpoint or initialize weights from scratch
    start_epoch, user_factors, item_factors = load_latest_checkpoint(run_checkpoint_path)
    train_pd = train_data.compute()
    n_users = int(train_pd["user_idx"].max()) + 1
    n_items = int(train_pd["item_idx"].max()) + 1
    rank = int(best_hyperparams.get("rank", 50))

    if user_factors is None:
        logger.info("No checkpoint — initializing factors")
        user_factors, item_factors = _initialize_factors(n_users, n_items, rank)
    else:
        logger.info("Resuming from epoch %d", start_epoch)

    if item_factors is None or user_factors is None:
        raise RuntimeError("Checkpoint recovery failed: factors are None")

    partitions = _build_partition_matrices(train_pd, n_users, n_items)
    config = {"dask_scheduler_address": os.environ.get("DASK_SCHEDULER_ADDRESS")}
    with get_dask_client(mode=get_client_mode_from_config(config)) as client:
        for epoch in range(start_epoch, n_iter):
            logger.info("Epoch %d/%d", epoch + 1, n_iter)
            user_factors, item_factors = _run_epoch_update(
                partitions=partitions,
                user_factors=user_factors,
                item_factors=item_factors,
                best_hyperparams=best_hyperparams,
                client=client,
            )

            # Save checkpoint atomically after every epoch
            save_checkpoint(epoch + 1, user_factors, item_factors, run_checkpoint_path)

            if checkpoint_val_every_n_epochs > 0 and (epoch + 1) % checkpoint_val_every_n_epochs == 0:
                logger.info("Epoch %d/%d checkpoint saved", epoch + 1, n_iter)

    return user_factors, item_factors
