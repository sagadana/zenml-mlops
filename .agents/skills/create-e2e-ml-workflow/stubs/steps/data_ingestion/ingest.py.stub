"""ZenML step: ingest_data — load raw data into a Dask DataFrame."""
from __future__ import annotations

import logging
import os
import zipfile
from pathlib import Path
from typing import Annotated

import dask_expr as dd
import pandas as pd
from zenml import step

from workflows.<workflow_name>.materializers.dask_dataframe_materializer import DaskDataFrameMaterializer

logger = logging.getLogger(__name__)

_DATASET_URLS: dict[str, str] = {
    # Fill these with dataset URLs for your workflow, e.g.
    # "small": "https://...",
    # "full": "https://...",
}


def _download_and_extract(url: str, cache_dir: Path, target_name: str) -> Path:
    import urllib.request

    zip_path = cache_dir / f"{target_name}.zip"
    extract_dir = cache_dir / f"{target_name}-extracted"

    if extract_dir.exists():
        logger.info("Using cached dataset at %s", extract_dir)
        return extract_dir

    cache_dir.mkdir(parents=True, exist_ok=True)
    urllib.request.urlretrieve(url, zip_path)
    with zipfile.ZipFile(zip_path) as zf:
        zf.extractall(extract_dir)
    zip_path.unlink()
    return extract_dir


def _parse_raw_data(extract_dir: Path) -> pd.DataFrame:
    """
    Parse downloaded raw files into a canonical dataframe.

    Required columns:
      userId, movieId, rating, timestamp
    """
    raise ValueError(
        "Customize _parse_raw_data() for your workflow and return "
        "columns: userId, movieId, rating, timestamp"
    )


@step(enable_cache=True, output_materializers={"raw_data": DaskDataFrameMaterializer})
def ingest_data(
    dataset_size: str = "small",
    n_dask_partitions: int = 4,
) -> Annotated[dd.DataFrame, "raw_data"]:
    """
    Download/load raw data and return as a partitioned Dask DataFrame.
    Partition by the primary entity key range (e.g. userId) for efficient
    distributed factor updates in training.
    """
    if dataset_size not in _DATASET_URLS:
        raise ValueError(
            f"Unknown dataset_size: {dataset_size!r}. "
            f"Define it in _DATASET_URLS. Available: {list(_DATASET_URLS)}"
        )

    cache_dir = Path(os.environ.get("WORKFLOW_DATA_CACHE_DIR", "./data"))
    extract_dir = _download_and_extract(
        _DATASET_URLS[dataset_size],
        cache_dir=cache_dir,
        target_name=f"<workflow_name>-{dataset_size}",
    )
    raw_pd = _parse_raw_data(extract_dir)

    ddf = dd.from_pandas(raw_pd, npartitions=n_dask_partitions)
    ddf = ddf.set_index("userId").repartition(npartitions=n_dask_partitions).reset_index()

    logger.info("Created raw_data dataframe: %d rows, %d partitions", len(raw_pd), ddf.npartitions)
    return ddf
