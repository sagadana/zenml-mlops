"""ZenML step: validate_data."""
from __future__ import annotations

from typing import Annotated

import pandas as pd
from zenml import step


class DataValidationError(Exception):
    """Raised when dataset quality checks fail."""


@step(enable_cache=True)
def validate_data(
    raw_ratings: pd.DataFrame,
    min_sparsity: float = 0.95,
    min_ratings: int = 100_000,
) -> Annotated[dict, "validation_report"]:
    """
    Validate input data and return a summary report.

    Customize required columns, constraints, and any task-specific checks.
    """
    raise ValueError(
        "Customize validate_data() with your schema checks and validation thresholds."
    )
