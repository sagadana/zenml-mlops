"""ZenML step: build_encoders."""
from __future__ import annotations

from typing import Annotated

import pandas as pd
from zenml import step


@step(enable_cache=True)
def build_encoders(
    raw_ratings: pd.DataFrame,
    power_scaling_alpha: float = 0.5,
) -> tuple[
    Annotated[pd.Series, "user_encoder"],
    Annotated[pd.Series, "item_encoder"],
    Annotated[pd.DataFrame, "scaled_ratings"],
]:
    """
    Build dense integer encoders for primary entities and return transformed features.
    """
    raise ValueError("Customize build_encoders() for your entity ID columns.")
