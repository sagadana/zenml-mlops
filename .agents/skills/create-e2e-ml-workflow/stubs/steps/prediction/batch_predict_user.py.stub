"""ZenML steps: get_total_users, predict_user_batch."""
from __future__ import annotations

import math
from collections.abc import Iterator
from typing import Annotated

import numpy as np
import pandas as pd
from zenml import step
from zenml.enums import StepRuntime

from workflows.<workflow_name>.models.<workflow_name>_model import <ModelClassName>


def _iter_recommendation_rows(batch_results: list[dict], model_version: str) -> Iterator[dict]:
    """Flatten one batch of model recommendations into row records."""
    for result in batch_results:
        uid = result["user_id"]
        for rank_pos, rec in enumerate(result["recommendations"]):
            yield {
                "id": f"<workflow_name>-{uid}",
                "userId": uid,
                "itemId": int(rec["item_id"]),
                "score": float(rec["score"]),
                "factors": rank_pos + 1,
                "version": model_version,
            }


@step(enable_cache=True, runtime=StepRuntime.INLINE)
def get_total_users(
    model: <ModelClassName>,
    n_batches: int,
    min_user_batch_size: int,
) -> tuple[
    Annotated[int, "total_users"],
    Annotated[int, "batch_size"],
]:
    total_users = len(model.user_encoder.index)
    batch_size = max(min_user_batch_size, math.ceil(total_users / n_batches))
    return total_users, batch_size


@step(enable_cache=True, runtime=StepRuntime.ISOLATED)
def predict_user_batch(
    total_users: int,
    batch_size: int,
    batch_idx: int,
    model: <ModelClassName>,
    model_name: str,
    model_version: str,
    batch_top_k: int,
) -> Annotated[pd.DataFrame, "batch_recommendations"]:
    batch_start = batch_idx * batch_size
    batch_end = min(batch_start + batch_size, total_users)
    batch_ids = np.asarray(model.user_encoder.index[batch_start:batch_end].tolist(), dtype=np.int64)
    batch_results = model.batch_predict(batch_ids, top_k=batch_top_k)
    return pd.DataFrame.from_records(_iter_recommendation_rows(batch_results, model_version))
