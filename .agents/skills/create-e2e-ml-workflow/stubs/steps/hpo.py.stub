"""ZenML steps for in-memory Optuna suggestions and artifact-based HPO fan-in."""
from __future__ import annotations

import logging
from typing import Annotated, Literal

import optuna
import pandas as pd
from pydantic import BaseModel
from zenml import log_metadata, step

logger = logging.getLogger(__name__)
type HPOMetric = Literal["loss", "precision", "recall", "ndcg"]


class TrialConfig(BaseModel):
    idx: int
    params: dict[str, float | int]
    metric: HPOMetric


class TrialResult(TrialConfig):
    value: float


def _train_model_subsample(
    train_pd: pd.DataFrame,
    val_pd: pd.DataFrame,
    params: dict[str, float | int],
    n_workers: int,
) -> float:
    """Customize this method with your algorithm's trial training logic."""
    raise ValueError(
        "Customize _train_model_subsample() for your workflow algorithm. "
        "It must return a scalar objective value to minimize."
    )


# NOTE: Not a ZenML step — runs in-memory Optuna sampling, called directly from the pipeline.
def suggest_hpo_trials(
    hpo_n_trials: int,
    hpo_metric: HPOMetric = "loss",
    seed: int = 42,
) -> Annotated[list[TrialConfig], "hpo_trial_configs"]:
    """Sample configurations from an in-memory Optuna study."""
    study = optuna.create_study(
        direction="minimize" if hpo_metric == "loss" else "maximize",
        sampler=optuna.samplers.TPESampler(seed=seed),
    )
    trial_configs: list[TrialConfig] = []
    for trial_idx in range(hpo_n_trials):
        trial = study.ask()
        trial_configs.append(
            TrialConfig(
                idx=trial_idx,
                params={
                    "factors": trial.suggest_int("factors", 10, 100),
                    "regularization": trial.suggest_float("regularization", 1e-3, 1.0, log=True),
                    "alpha": trial.suggest_float("alpha", 1.0, 40.0),
                    "n_iter": trial.suggest_int("n_iter", 5, 60),
                },
                metric=hpo_metric,
            )
        )
    return trial_configs


@step(enable_cache=False)
def run_hpo_trial(
    trial_config: TrialConfig,
    train_data: pd.DataFrame,
    val_data: pd.DataFrame,
    n_workers: int = 4,
    hpo_subsample_fraction: float = 0.2,
    seed: int = 42,
) -> Annotated[TrialResult, "trial_result"]:
    train_pd = train_data
    val_pd = val_data

    if hpo_subsample_fraction < 1.0:
        trial_seed = seed + trial_config.idx
        train_pd = train_pd.sample(frac=hpo_subsample_fraction, random_state=trial_seed)
        val_pd = val_pd.sample(frac=hpo_subsample_fraction, random_state=trial_seed)

    value = _train_model_subsample(
        train_pd,
        val_pd,
        trial_config.params,
        n_workers,
    )
    log_metadata(metadata={"hpo_trial_idx": trial_config.idx, "hpo_value": value})
    return TrialResult(
        idx=trial_config.idx,
        value=value,
        params=trial_config.params,
        metric=trial_config.metric,
    )


@step(enable_cache=False)
def collect_best_hpo_params(
    trial_results: list[TrialResult],
) -> Annotated[dict[str, float | int], "best_hyperparams"]:
    """Fan in mapped trial-result artifacts and select the best parameters."""
    if not trial_results:
        raise ValueError("No HPO trial results were received")
    metric = trial_results[0].metric
    best = (
        min(trial_results, key=lambda result: result.value)
        if metric == "loss"
        else max(trial_results, key=lambda result: result.value)
    )
    return best.params
