"""ZenML step: register_model — build model object, register with MCP, promote if quality gate passes."""
from __future__ import annotations
import logging
from typing import Annotated
import numpy as np
import pandas as pd
from zenml import Model, get_step_context, log_metadata, step
from workflows.<workflow_name>.materializers.model_materializer import <ModelClassName>Materializer
from workflows.<workflow_name>.models.<workflow_name>_model import <ModelClassName>
from helpers.checkpointing import clean_run_checkpoints

logger = logging.getLogger(__name__)
_MODEL_NAME = "<model_zenml_name>"


@step(
    enable_cache=False,
    output_materializers={"model": <ModelClassName>Materializer},
    model=Model(name=_MODEL_NAME),
)
def register_model(
    user_factors: np.ndarray,
    item_factors: np.ndarray,
    user_encoder: pd.Series,
    item_encoder: pd.Series,
    eval_metrics: dict,
    best_hyperparams: dict,
    rmse_threshold: float = 1.0,
    checkpoint_path: str = "./checkpoints",
) -> Annotated[<ModelClassName>, "model"]:
    """
    Wrap weights into model object, register with ZenML MCP.
    Promotes to 'staging' if rmse < rmse_threshold (quality gate).
    Cleans up epoch checkpoints on successful registration.
    """
    try:
        version = str(get_step_context().model.version)
    except Exception:
        version = "unknown"

    model = <ModelClassName>(
        user_factors=user_factors.astype(np.float32),
        item_factors=item_factors.astype(np.float32),
        user_encoder=user_encoder,
        item_encoder=item_encoder,
        rank=int(best_hyperparams.get("rank", user_factors.shape[1])),
        model_version=version,
    )

    log_metadata(
        metadata={
            **eval_metrics,
            **best_hyperparams,
            "n_users": model.n_users,
            "n_items": model.n_items,
        },
        infer_model=True,
    )

    rmse = float(eval_metrics.get("rmse", float("inf")))
    if rmse < rmse_threshold:
        logger.info("Quality gate PASSED (RMSE=%.4f). Promoting to staging.", rmse)
        try:
            get_step_context().model.set_stage("staging", force=True)
        except Exception as exc:
            logger.warning("Could not promote to staging: %s", exc)
    else:
        logger.warning("Quality gate FAILED (RMSE=%.4f >= %.4f). Not promoted.", rmse, rmse_threshold)

    try:
        run_id = get_step_context().pipeline_run.id
        clean_run_checkpoints(f"{checkpoint_path}/{run_id}")
    except Exception as exc:
        logger.warning("Checkpoint cleanup skipped: %s", exc)

    return model
