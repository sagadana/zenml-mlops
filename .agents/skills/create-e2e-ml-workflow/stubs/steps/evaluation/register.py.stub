"""ZenML step: register_model — build model object, register with MCP, promote if quality gate passes."""
from __future__ import annotations
import logging
from typing import Annotated
import numpy as np
import pandas as pd
from zenml import Model, get_step_context, log_metadata, step
from workflows.<workflow_name>.configs import CFG_MODEL_NAME
from workflows.<workflow_name>.materializers.model_materializer import <ModelClassName>Materializer
from workflows.<workflow_name>.models.<workflow_name>_model import <ModelClassName>

logger = logging.getLogger(__name__)

@step(
    enable_cache=False,
    output_materializers={"model": <ModelClassName>Materializer},
    model=Model(name=CFG_MODEL_NAME),
)
def register_model(
    user_factors: np.ndarray,
    item_factors: np.ndarray,
    user_encoder: pd.Series,
    item_encoder: pd.Series,
    eval_metrics: dict,
    best_hyperparams: dict,
    precision_at_k_threshold: float = 0.0,
    recall_at_k_threshold: float = 0.0,
    ndcg_at_k_threshold: float = 0.0,
    model_stage: str = "staging",
    recommender_class_name: str = "workflows.<workflow_name>.models.<workflow_name>_model.<ModelClassName>",
) -> Annotated[<ModelClassName>, "model"]:
    """
    Wrap weights into model object, register with ZenML MCP.
    Promotes to model_stage if ranking metrics pass all quality gate thresholds.
    """
    try:
        version = str(get_step_context().model.version)
    except Exception:
        version = "unknown"

    model = <ModelClassName>(
        user_factors=user_factors.astype(np.float32),
        item_factors=item_factors.astype(np.float32),
        user_encoder=user_encoder,
        item_encoder=item_encoder,
        rank=int(best_hyperparams.get("rank", user_factors.shape[1])),
        model_version=version,
    )

    log_metadata(
        metadata={
            **eval_metrics,
            **best_hyperparams,
            "n_users": model.n_users,
            "n_items": model.n_items,
        },
        infer_model=True,
    )

    precision_at_k = float(eval_metrics.get("precision_at_k", 0.0))
    recall_at_k = float(eval_metrics.get("recall_at_k", 0.0))
    ndcg_at_k = float(eval_metrics.get("ndcg_at_k", 0.0))

    gate_passed = (
        precision_at_k >= precision_at_k_threshold
        and recall_at_k >= recall_at_k_threshold
        and ndcg_at_k >= ndcg_at_k_threshold
    )

    if gate_passed:
        logger.info(
            "Quality gate PASSED (P@K=%.4f, R@K=%.4f, NDCG@K=%.4f). Promoting to %s.",
            precision_at_k, recall_at_k, ndcg_at_k, model_stage,
        )
        try:
            get_step_context().model.set_stage(model_stage, force=True)
        except Exception as exc:
            logger.warning("Could not promote to %s: %s", model_stage, exc)
    else:
        logger.warning(
            "Quality gate FAILED (P@K=%.4f, R@K=%.4f, NDCG@K=%.4f). Not promoted.",
            precision_at_k, recall_at_k, ndcg_at_k,
        )

    return model
