"""ZenML step: split_data."""
from __future__ import annotations

from typing import Annotated

import pandas as pd
from zenml import step


@step(enable_cache=True)
def split_data(
    raw_ratings: pd.DataFrame,
    user_encoder: pd.Series,
    item_encoder: pd.Series,
    train_ratio: float = 0.8,
    val_ratio: float = 0.1,
    test_ratio: float = 0.1,
) -> tuple[
    Annotated[pd.DataFrame, "train_data"],
    Annotated[pd.DataFrame, "val_data"],
    Annotated[pd.DataFrame, "test_data"],
]:
    """
    Encode identifiers and split into train/validation/test sets.
    """
    raise ValueError(
        "Customize split_data() with your leakage-safe split strategy and feature columns."
    )
