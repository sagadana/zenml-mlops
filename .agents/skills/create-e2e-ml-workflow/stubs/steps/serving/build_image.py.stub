"""ZenML step: build_serving_image."""
from __future__ import annotations

import logging
import subprocess
from typing import Annotated

from zenml import step
from zenml.client import Client

logger = logging.getLogger(__name__)

_MODEL_NAME = "<model_zenml_name>"


@step(enable_cache=False)
def build_serving_image(
    ecr_uri: str = "",
    model_stage: str = "staging",
) -> Annotated[str, "serving_image_uri"]:
    client = Client()
    model_version = client.get_model_version(_MODEL_NAME, model_stage)
    version_str = str(model_version.version).replace(" ", "-").lower()

    local_tag = f"<workflow_name>-serving:{version_str}"
    image_uri = f"{ecr_uri}/aips-zenml/<workflow_name>-serving:{version_str}" if ecr_uri else local_tag

    result = subprocess.run(
        [
            "docker",
            "build",
            "-t",
            local_tag,
            "-f",
            "docker/serving/Dockerfile",
            "--build-arg",
            "WORKFLOW=<workflow_name>",
            ".",
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(f"Docker build failed: {result.stderr[:500]}")

    if ecr_uri:
        subprocess.run(["docker", "tag", local_tag, image_uri], check=True)
        subprocess.run(["docker", "push", image_uri], check=True)

    return image_uri
