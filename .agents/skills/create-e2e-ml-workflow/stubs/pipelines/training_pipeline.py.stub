"""Training pipeline with optional HPO fan-out and single-step full-dataset training."""
from __future__ import annotations

from zenml import pipeline
from zenml.config import StepRetryConfig

from workflows.<workflow_name>.configs import (
    CFG_TRAINING_PIPELINE_NAME,
    CFG_TRAINING_PIPELINE_SNAPSHOT_DESCRIPTION,
    CFG_TRAINING_PIPELINE_SNAPSHOT_NAME,
    CFG_WORKFLOW_NAME,
)
from workflows.<workflow_name>.steps.features.artifacts import (
    load_features_artifact,
)
from workflows.<workflow_name>.steps.features.split import prepare_features, split_data
from workflows.<workflow_name>.steps.hpo.run_hpo import (
    cleanup_hpo_checkpoints,
    collect_best_hpo_params,
    run_hpo_trial,
)
from workflows.<workflow_name>.steps.evaluation.register import MODEL, register_model
from workflows.<workflow_name>.steps.training.train_<algo> import train_<algo>
from workflows.<workflow_name>.steps.training.visualize import visualize_training


@pipeline(
    name=CFG_TRAINING_PIPELINE_NAME,
    model=MODEL,
    retry=StepRetryConfig(max_retries=2, backoff=2, delay=5),
)
def training_pipeline(
    model_stage: str = "staging",
    factors: int = 50,
    regularization: float = 0.01,
    alpha: float = 1.0,
    n_iter: int = 15,
    n_workers: int = 4,
    k: int = 10,
    eval_every_n_epochs: int = 1,
    checkpoint_every_n_epochs: int = 1,
    recommender_class_name: str = "workflows.<workflow_name>.models.<workflow_name>_model.<ModelClassName>",
    enable_hpo: bool = False,
    hpo_n_trials: int = 20,
    hpo_subsample_fraction: float = 0.2,
    optuna_storage: str = "sqlite:///optuna.db",
    optuna_study_name: str = "<workflow_name>_study",
    hpo_metric: str = "loss",
    checkpoint_path: str = "s3://${ZENML_CHECKPOINT_BUCKET}",
    seaweedfs_s3_internal_endpoint: str | None = None,
    zenml_local_s3_secret_name: str | None = None,
    enable_warm_start: bool = False,
    warm_start_model_stage: str | None = None,
) -> None:
    # ── Step 1: Load precomputed features artifact ───────────────────────────
    user_encoder, item_encoder, scaled_ratings = load_features_artifact()

    # ── Step 2: Prepare full-dataset features (always) ───────────────────────
    features = prepare_features(
        raw_ratings=scaled_ratings,
        user_encoder=user_encoder,
        item_encoder=item_encoder,
    )

    # ── Step 3: HPO (optional fan-out) ───────────────────────────────────────
    # Default hyperparams (overridden by HPO if enable_hpo=True)
    from workflows.<workflow_name>.models.<workflow_name>_model import Hyperparameters  # replace with your Hyperparameters type
    default_hyperparams = Hyperparameters(
        factors=factors,
        regularization=regularization,
        alpha=alpha,
        n_iter=n_iter,
    )

    if enable_hpo:
        # Split data is only needed for HPO trials
        train_data, val_data, test_data = split_data(
            id="split_data",
            raw_ratings=scaled_ratings,
            user_encoder=user_encoder,
            item_encoder=item_encoder,
        )

        after = []
        for i in range(hpo_n_trials):
            trial = run_hpo_trial(
                id=f"hpo_trial_{i}",
                trial_idx=i,
                train_data=train_data,
                val_data=val_data,
                n_workers=n_workers,
                hpo_subsample_fraction=hpo_subsample_fraction,
                optuna_storage=optuna_storage,
                optuna_study_name=optuna_study_name,
                hpo_metric=hpo_metric,
                recommender_class_name=recommender_class_name,
                checkpoint_path=checkpoint_path,
                seaweedfs_s3_internal_endpoint=seaweedfs_s3_internal_endpoint,
                zenml_local_s3_secret_name=zenml_local_s3_secret_name,
            )
            after.append(trial)

        best_hyperparams = collect_best_hpo_params(
            optuna_storage=optuna_storage,
            optuna_study_name=optuna_study_name,
            after=after,
        )
        cleanup_hpo_checkpoints(
            checkpoint_path=checkpoint_path,
            seaweedfs_s3_internal_endpoint=seaweedfs_s3_internal_endpoint,
            zenml_local_s3_secret_name=zenml_local_s3_secret_name,
            after=[best_hyperparams],
        )
    else:
        best_hyperparams = default_hyperparams

    # ── Step 4: Train on full dataset ─────────────────────────────────────────
    user_factors, item_factors, training_states = train_<algo>(
        id="train_<algo>",
        features=features,
        best_hyperparams=best_hyperparams,
        checkpoint_path=checkpoint_path,
        n_workers=n_workers,
        eval_at_k=k,
        eval_every_n_epochs=eval_every_n_epochs,
        checkpoint_every_n_epochs=checkpoint_every_n_epochs,
        recommender_class_name=recommender_class_name,
        enable_warm_start=enable_warm_start,
        warm_start_model_stage=warm_start_model_stage,
        user_encoder=user_encoder,
        item_encoder=item_encoder,
        seaweedfs_s3_internal_endpoint=seaweedfs_s3_internal_endpoint,
        zenml_local_s3_secret_name=zenml_local_s3_secret_name,
    )

    visualize_training(training_states=training_states)

    # ── Step 5: Register (metrics come from training_states, no separate eval) ─
    register_model(
        id="register_model",
        user_factors=user_factors,
        item_factors=item_factors,
        user_encoder=user_encoder,
        item_encoder=item_encoder,
        training_states=training_states,
        best_hyperparams=best_hyperparams,
        model_stage=model_stage,
        recommender_class_name=recommender_class_name,
    )


training_pipeline.create_snapshot(
    name=CFG_TRAINING_PIPELINE_SNAPSHOT_NAME,
    description=CFG_TRAINING_PIPELINE_SNAPSHOT_DESCRIPTION,
    tags=[CFG_WORKFLOW_NAME, "training"],
    replace=True,
)
