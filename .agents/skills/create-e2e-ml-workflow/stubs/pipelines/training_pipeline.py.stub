"""Training pipeline: HPO (optional) → train → evaluate → register."""
from __future__ import annotations
from zenml import Model, pipeline
from workflows.<workflow_name>.steps.data_ingestion.ingest import ingest_data
from workflows.<workflow_name>.steps.data_validation.validate import validate_data
from workflows.<workflow_name>.steps.feature_engineering.encoders import build_encoders
from workflows.<workflow_name>.steps.feature_engineering.split import split_data
from workflows.<workflow_name>.steps.hpo.run_hpo import run_hpo
from workflows.<workflow_name>.steps.training.train import train_model
from workflows.<workflow_name>.steps.model_evaluation.evaluate import compute_metrics
from workflows.<workflow_name>.steps.model_evaluation.register import register_model

_MODEL = Model(name="<model_zenml_name>")


@pipeline(name="<workflow_name>_training", enable_cache=True, model=_MODEL)
def training_pipeline(
    dataset_size: str = "small",
    data_n_dask_partitions: int = 4,
    min_sparsity: float = 0.95,
    min_ratings: int = 100_000,
    train_ratio: float = 0.8,
    val_ratio: float = 0.1,
    test_ratio: float = 0.1,
    rank: int = 50,
    regularization: float = 0.01,
    alpha: float = 1.0,
    n_iter: int = 15,
    enable_hpo: bool = False,
    hpo_n_trials: int = 20,
    hpo_subsample_fraction: float = 0.2,
    optuna_storage: str = "sqlite:///optuna.db",
    optuna_study_name: str = "<workflow_name>",
    checkpoint_path: str = "./checkpoints",
    train_n_dask_partitions: int = 4,
    checkpoint_val_every_n_epochs: int = 5,
    rmse_threshold: float = 1.0,
    top_k: int = 10,
) -> None:
    """
    Full training pipeline. Checkpointing in train_model enables automatic resume:
    if this pipeline is interrupted and re-run, all cached steps are skipped and
    train_model resumes from the last completed epoch.
    """
    raw_data = ingest_data(dataset_size=dataset_size, n_dask_partitions=data_n_dask_partitions)
    validate_data(raw_data=raw_data, min_sparsity=min_sparsity, min_ratings=min_ratings)
    user_encoder, item_encoder = build_encoders(raw_data=raw_data)
    train_data, val_data, test_data = split_data(
        raw_data=raw_data, user_encoder=user_encoder, item_encoder=item_encoder,
        train_ratio=train_ratio, val_ratio=val_ratio, test_ratio=test_ratio,
    )

    default_hyperparams = {
        "rank": rank,
        "regularization": regularization,
        "alpha": alpha,
        "n_iter": n_iter,
    }

    if enable_hpo:
        best_hyperparams = run_hpo(
            train_data=train_data, val_data=val_data,
            hpo_n_trials=hpo_n_trials, hpo_subsample_fraction=hpo_subsample_fraction,
            optuna_storage=optuna_storage, optuna_study_name=optuna_study_name,
        )
    else:
        best_hyperparams = default_hyperparams

    user_factors, item_factors = train_model(
        train_data=train_data, val_data=val_data,
        best_hyperparams=best_hyperparams,
        checkpoint_path=checkpoint_path,
        n_dask_partitions=train_n_dask_partitions,
        checkpoint_val_every_n_epochs=checkpoint_val_every_n_epochs,
    )

    eval_metrics = compute_metrics(
        test_data=test_data,
        user_factors=user_factors, item_factors=item_factors,
        best_hyperparams=best_hyperparams, top_k=top_k,
    )

    register_model(
        user_factors=user_factors, item_factors=item_factors,
        user_encoder=user_encoder, item_encoder=item_encoder,
        eval_metrics=eval_metrics, best_hyperparams=best_hyperparams,
        rmse_threshold=rmse_threshold, checkpoint_path=checkpoint_path,
    )
