"""Training pipeline: HPO (optional) → train → evaluate → register."""
from __future__ import annotations
from zenml import Model, pipeline
from workflows.<workflow_name>.steps.data_ingestion.ingest import ingest_data
from workflows.<workflow_name>.steps.data_validation.validate import validate_data
from workflows.<workflow_name>.steps.feature_engineering.encoders import build_encoders
from workflows.<workflow_name>.steps.feature_engineering.split import split_data
from workflows.<workflow_name>.steps.hpo.run_hpo import run_hpo
from workflows.<workflow_name>.steps.training.train import train_model
from workflows.<workflow_name>.steps.model_evaluation.evaluate import compute_metrics
from workflows.<workflow_name>.steps.model_evaluation.register import register_model

_MODEL = Model(name="<model_name>")


@pipeline(name="<workflow_name>_training", enable_cache=True, model=_MODEL)
def training_pipeline(
    rank: int = 50,
    regularization: float = 0.01,
    alpha: float = 1.0,
    n_iter: int = 15,
    enable_hpo: bool = False,
) -> None:
    """
    Full training pipeline. Checkpointing in train_model enables automatic resume:
    if this pipeline is interrupted and re-run, all cached steps are skipped and
    train_model resumes from the last completed epoch.
    """
    raw_data = ingest_data()
    validate_data(raw_data=raw_data)
    user_encoder, item_encoder = build_encoders(raw_data=raw_data)
    train_data, val_data, test_data = split_data(
        raw_data=raw_data,
        user_encoder=user_encoder,
        item_encoder=item_encoder,
    )

    default_hyperparams = {
        "rank": rank,
        "regularization": regularization,
        "alpha": alpha,
        "n_iter": n_iter,
    }

    if enable_hpo:
        best_hyperparams = run_hpo(train_data=train_data, val_data=val_data)
    else:
        best_hyperparams = default_hyperparams

    user_factors, item_factors = train_model(
        train_data=train_data,
        val_data=val_data,
        best_hyperparams=best_hyperparams,
    )

    eval_metrics = compute_metrics(
        test_data=test_data,
        user_factors=user_factors,
        item_factors=item_factors,
        best_hyperparams=best_hyperparams,
    )

    register_model(
        user_factors=user_factors,
        item_factors=item_factors,
        user_encoder=user_encoder,
        item_encoder=item_encoder,
        eval_metrics=eval_metrics,
        best_hyperparams=best_hyperparams,
    )
