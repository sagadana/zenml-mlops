"""Online evaluation pipeline: ranking metrics against inference logs."""
from zenml import pipeline
from zenml.integrations.evidently.column_mapping import EvidentlyColumnMapping
from zenml.integrations.evidently.metrics import EvidentlyMetricConfig

from workflows.<workflow_name>.configs import (
    CFG_ONLINE_EVALUATION_PIPELINE_NAME,
    CFG_ONLINE_EVALUATION_PIPELINE_SNAPSHOT_DESCRIPTION,
    CFG_ONLINE_EVALUATION_PIPELINE_SNAPSHOT_NAME,
    CFG_WORKFLOW_NAME,
)
from workflows.<workflow_name>.steps.data.ingest import ingest_batch_predictions
from workflows.<workflow_name>.steps.evaluation.evaluate import evidently_report
from workflows.<workflow_name>.steps.features.artifacts import load_scaled_ratings_artifact
from workflows.<workflow_name>.steps.features.select import select_feature_columns

_RANKING_COLUMNS = ["userId", "itemId", "rating"]


@pipeline(name=CFG_ONLINE_EVALUATION_PIPELINE_NAME)
def online_evaluation_pipeline(top_k: int = 10) -> None:
    # Reference: ground-truth ratings from training data
    scaled_ratings = load_scaled_ratings_artifact()
    reference_dataset = select_feature_columns(
        features=scaled_ratings,
        columns=_RANKING_COLUMNS,
        force=True,
        id="select_reference_features",
    )

    # Current: recent model predictions. Use ingest_prediction_logs instead when evaluating
    # real-time serving logs rather than batch recommendation output.
    inference_logs = ingest_batch_predictions(model_name="<model_name>")
    current_dataset = select_feature_columns(
        features=inference_logs,
        columns=_RANKING_COLUMNS,
        force=True,
        id="select_current_features",
    )

    _, _ = evidently_report(
        reference_dataset=reference_dataset,
        comparison_dataset=current_dataset,
        column_mapping=EvidentlyColumnMapping(
            user_id="userId",
            item_id="movieId",
            predictions="rating",
            target="rating",
            recommendations_type="score",
        ),
        metrics=[
            EvidentlyMetricConfig.metric("PrecisionTopK", k=top_k),
            EvidentlyMetricConfig.metric("RecallTopK", k=top_k),
            EvidentlyMetricConfig.metric("NDCG", k=top_k),
            EvidentlyMetricConfig.metric("MAP", k=top_k),
            EvidentlyMetricConfig.metric("ScoreDistribution", k=top_k),
        ],
        id="evidently_ranking",
    )


online_evaluation_pipeline.create_snapshot(
    name=CFG_ONLINE_EVALUATION_PIPELINE_SNAPSHOT_NAME,
    description=CFG_ONLINE_EVALUATION_PIPELINE_SNAPSHOT_DESCRIPTION,
    tags=[CFG_WORKFLOW_NAME, "online-evaluation", "ranking"],
    replace=True,
)
