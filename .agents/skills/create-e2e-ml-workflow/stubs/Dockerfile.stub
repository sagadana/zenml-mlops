FROM python:3.12-slim as base
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && pip install --no-cache-dir -e "."
RUN zenml integration install aws s3 mlflow -y --no-input 2>/dev/null || true
COPY . .
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "run.py"]
