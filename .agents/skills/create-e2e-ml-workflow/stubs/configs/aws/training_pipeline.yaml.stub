# ZenML pipeline run configuration — AWS production (training_pipeline)
enable_cache: true
enable_step_logs: true
enable_artifact_metadata: true
enable_artifact_visualization: true

settings:
  resources:
    cpu_count: 1
    gpu_count: 0
    memory: "1GB"
  docker:
    image_tag: "aws-training-pipeline"
    dockerfile: "docker/pipeline/Dockerfile"
    build_context_root: "."
    disable_automatic_requirements_detection: true

parameters:
  model_stage: "production"
  factors: 100
  regularization: 0.01
  alpha: 1.0
  n_iter: 20
  n_workers: 8
  k: 10
  eval_every_n_epochs: 1
  checkpoint_every_n_epochs: 1
  recommender_class_name: "workflows.<workflow_name>.models.<workflow_name>_model.<ModelClassName>"
  enable_hpo: true
  hpo_n_trials: 200
  hpo_subsample_fraction: 0.2
  optuna_storage: "${OPTUNA_STORAGE_URI}"
  optuna_study_name: "<workflow_name>_aws"
  hpo_metric: "loss"
  checkpoint_path: "s3://${ZENML_CHECKPOINT_BUCKET}"
  seaweedfs_s3_internal_endpoint: "${SEAWEEDFS_S3_INTERNAL_ENDPOINT}"
  zenml_local_s3_secret_name: "${ZENML_LOCAL_S3_SECRET_NAME}"
  enable_warm_start: false
  warm_start_model_stage: "production"

steps:
  load_features_artifact:
    runtime: inline
    enable_cache: false

  split_data:
    runtime: inline
    enable_cache: true
    step_operator: true
    parameters:
      train_ratio: 0.9
      val_ratio: 0.1

  run_hpo_trial:
    runtime: isolated
    step_operator: true

  train_<algo>:
    runtime: isolated
    enable_cache: true
    step_operator: true

  register_model:
    runtime: inline
    enable_cache: false
    parameters:
      precision_at_k_threshold: 0.01
      recall_at_k_threshold: 0.01
      ndcg_at_k_threshold: 0.01
