# ZenML pipeline run config — AWS production (serving_pipeline)
# Used with: python run.py run --workflow <workflow_name> --pipeline serving_pipeline --config workflows/<workflow_name>/configs/aws/serving_pipeline.yaml --stack aws_stack
enable_cache: false
enable_step_logs: true
enable_artifact_metadata: true
enable_artifact_visualization: true

settings:
  resources:
    cpu_count: 1
    gpu_count: 0
    memory: "1GB"
  docker:
    dockerfile: "docker/pipeline/Dockerfile"

steps:
  generate_batch_recommendations:
    enable_cache: false
    step_operator: true
    parameters:
      batch_top_k: 50
      batch_output_path: "s3://zenml-predictions/batch/<workflow_name>"
      checkpoint_path: "s3://zenml-checkpoints"
      model_stage: "production"
      dynamodb_table: "<workflow_name>-recommendations"
      dynamodb_partition_key: "id"
      user_batch_size: 10000
      n_parallel_batches: 8
  build_serving_image:
    enable_cache: false
    parameters:
      ecr_uri: "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
      model_stage: "production"
      service_name: ${SERVICE:-zenml-mlops}
      workflow_name: "<workflow_name>"
  deploy_endpoint:
    enable_cache: false
    parameters:
      endpoint_name: "<workflow_name>-endpoint"
      instance_type: "ml.t2.medium"
      deploy_mode: "sagemaker"
      local_port: 8080
