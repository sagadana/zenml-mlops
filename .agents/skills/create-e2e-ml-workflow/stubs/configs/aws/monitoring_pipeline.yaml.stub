# ZenML pipeline run config — AWS production (monitoring_pipeline)
enable_cache: false
enable_step_logs: true
enable_artifact_metadata: true
enable_artifact_visualization: true

settings:
  resources:
    cpu_count: 1
    gpu_count: 0
    memory: "1GB"
  docker:
    image_tag: "aws-monitoring-pipeline"
    dockerfile: "docker/pipeline/Dockerfile"
    build_context_root: "."
    disable_automatic_requirements_detection: true

steps:
  load_raw_ratings_artifact:
    runtime: inline
    enable_cache: false
    parameters:
      sample_fraction: 0.2 # Example: randomly sample 20% of the data

  ingest_data:
    enable_cache: false
    parameters:
      dataset_table: "<dataset_table>"
      spark_master_url: "${SPARK_MASTER_URL}"
      lookback_days: 30
      sample_fraction: 0.2 # Example: randomly sample 20% of the data

  check_retrain:
    enable_cache: false
    parameters:
      model_stage: "production"
      drifted_column_share_threshold: 0.5
      missing_values_share_threshold: 0.1
      max_age_days: 30
