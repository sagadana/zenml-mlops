# ZenML pipeline run config — AWS production (batch_inference_pipeline)

enable_cache: false
enable_step_logs: true
enable_artifact_metadata: true
enable_artifact_visualization: true

settings:
  resources:
    cpu_count: 1
    gpu_count: 0
    memory: "1GB"
  docker:
    image_tag: "aws-batch-inference-pipeline"
    dockerfile: "docker/pipeline/Dockerfile"
    build_context_root: "."
    disable_automatic_requirements_detection: true

parameters:
  n_batches: 17
  model_stage: "production"
  batch_top_k: 50
  min_user_batch_size: 10000
  batch_output_path: "s3://${ZENML_PREDICTIONS_BUCKET}/batch"
  dynamodb_table: "${ZENML_BATCH_DDB_TABLE_NAME:-<workflow_name>-recommendations}"
  dynamodb_partition_key: "${ZENML_BATCH_DDB_PARTITION_KEY_NAME:-id}"
  dynamodb_region: "${AWS_REGION}"
  seaweedfs_s3_internal_endpoint: "${SEAWEEDFS_S3_INTERNAL_ENDPOINT}"
  zenml_local_s3_secret_name: "${ZENML_LOCAL_S3_SECRET_NAME}"

steps:
  load_als_model:
    runtime: inline
    enable_cache: false
    step_operator: true

  collect_batch_recommendations:
    runtime: inline
    enable_cache: false
    step_operator: true
