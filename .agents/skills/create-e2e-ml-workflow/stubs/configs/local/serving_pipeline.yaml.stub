# ZenML pipeline run config — LOCAL development (serving_pipeline)
# Used with: python run.py run --workflow <workflow_name> --pipeline serving_pipeline --config workflows/<workflow_name>/configs/local/serving_pipeline.yaml
enable_cache: false
enable_step_logs: true
enable_pipeline_logs: true
enable_artifact_metadata: true
enable_artifact_visualization: true

settings:
  docker:
    dockerfile: "docker/pipeline/Dockerfile"

steps:
  generate_batch_recommendations:
    enable_cache: false
    parameters:
      batch_top_k: 50
      batch_output_path: "./predictions/batch"
      checkpoint_path: "./checkpoints"
      model_stage: "staging"
      dynamodb_table: ""
      dynamodb_partition_key: "id"
      user_batch_size: 10000
      n_parallel_batches: 2
  build_serving_image:
    enable_cache: false
    parameters:
      ecr_uri: ""
      model_stage: "staging"
      service_name: ${SERVICE:-zenml-mlops}
      workflow_name: "<workflow_name>"
  deploy_endpoint:
    enable_cache: false
    parameters:
      endpoint_name: "<workflow_name>-endpoint"
      instance_type: "ml.t2.medium"
      deploy_mode: "local"
      local_port: 8080
