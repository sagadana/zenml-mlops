# ZenML pipeline run config — LOCAL development (training_pipeline)
enable_cache: true
enable_step_logs: true
enable_pipeline_logs: true
execution_mode: "stop_on_failure"
enable_artifact_metadata: true
enable_artifact_visualization: true

settings:
  docker:
    image_tag: "local-training-pipeline"
    dockerfile: "docker/pipeline/Dockerfile"
    build_context_root: "."
    disable_automatic_requirements_detection: true

parameters:
  features_artifact_name: "<workflow_name>_features_encoders"
  rank: 50
  regularization: 0.01
  alpha: 1.0
  n_iter: 15
  n_workers: 4
  checkpoint_val_every_n_epochs: 1
  enable_hpo: true
  hpo_n_trials: 20
  hpo_subsample_fraction: 0.2
  optuna_storage: "${OPTUNA_STORAGE_URI}"
  optuna_study_name: "<workflow_name>_local"
  checkpoint_path: "s3://${ZENML_CHECKPOINT_BUCKET}"
  seaweedfs_s3_internal_endpoint: "${SEAWEEDFS_S3_INTERNAL_ENDPOINT}"
  zenml_local_s3_secret_name: "${ZENML_LOCAL_S3_SECRET_NAME}"

steps:
  ingest_data:
    enable_cache: true
    parameters:
      dataset_size: "small"

  load_features_artifact:
    enable_cache: false

  split_data:
    enable_cache: true
    parameters:
      train_ratio: 0.8
      val_ratio: 0.1
      test_ratio: 0.1

  compute_metrics:
    enable_cache: true
    parameters:
      top_k: 10

  register_model:
    enable_cache: false
    parameters:
      rmse_threshold: 1.0
