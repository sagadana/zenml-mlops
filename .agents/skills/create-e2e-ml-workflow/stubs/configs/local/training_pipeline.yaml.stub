# ZenML pipeline run configuration — LOCAL development (training_pipeline)
enable_step_logs: true
enable_pipeline_logs: true
execution_mode: "stop_on_failure"
enable_artifact_metadata: true
enable_artifact_visualization: true

settings:
  docker:
    image_tag: "local-training-pipeline"
    dockerfile: "docker/pipeline/Dockerfile"
    build_context_root: "."
    disable_automatic_requirements_detection: true

parameters:
  model_stage: "staging"
  factors: 50
  regularization: 0.01
  alpha: 1.0
  n_iter: 15
  n_workers: 4
  k: 10
  eval_every_n_epochs: 1
  checkpoint_every_n_epochs: 1
  recommender_class_name: "workflows.<workflow_name>.models.<workflow_name>_model.<ModelClassName>"
  enable_hpo: true
  hpo_n_trials: 20
  hpo_subsample_fraction: 0.2
  optuna_storage: "${OPTUNA_STORAGE_URI}"
  optuna_study_name: "<workflow_name>_local"
  hpo_metric: "loss"
  checkpoint_path: "s3://${ZENML_CHECKPOINT_BUCKET}"
  seaweedfs_s3_internal_endpoint: "${SEAWEEDFS_S3_INTERNAL_ENDPOINT}"
  zenml_local_s3_secret_name: "${ZENML_LOCAL_S3_SECRET_NAME}"
  trigger_serving_on_complete: true

steps:
  load_features_artifact:
    enable_cache: false

  split_data:
    enable_cache: true
    parameters:
      train_ratio: 0.8
      val_ratio: 0.1
      test_ratio: 0.1

  compute_metrics:
    enable_cache: true

  register_model:
    enable_cache: false
    parameters:
      precision_at_k_threshold: 0.01
      recall_at_k_threshold: 0.01
      ndcg_at_k_threshold: 0.01
      force_promote: true
