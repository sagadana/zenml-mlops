# ZenML pipeline run config — LOCAL development
# Used with: python run.py run --workflow <workflow_name> --pipeline training --config workflows/<workflow_name>/configs/local.yaml
enable_cache: true
enable_step_logs: true
enable_pipeline_logs: true
execution_mode: "stop_on_failure"
enable_artifact_metadata: True
enable_artifact_visualization: True

# ── Pipeline-level infrastructure settings ────────────────────────────────────
settings:
  docker:
    dockerfile: "docker/pipeline/Dockerfile"

parameters:
  # Pipeline-level defaults (not step parameters)
  rank: 50
  regularization: 0.01
  alpha: 1.0
  n_iter: 15
  enable_hpo: false


# ── Step-level settings ───────────────────────────────────────────────────────
steps:
  ingest_data:
    enable_cache: true
    parameters:
      # Workflow-specific; controls which data variant to load
      dataset_size: "small"
      n_dask_partitions: 4
  validate_data:
    enable_cache: true
    parameters:
      min_sparsity: 0.95
      min_ratings: 100000
  build_encoders:
    enable_cache: true
  split_data:
    enable_cache: true
    parameters:
      train_ratio: 0.8
      val_ratio: 0.1
      test_ratio: 0.1
  run_hpo:
    enable_cache: false
    parameters:
      hpo_n_trials: 20
      hpo_subsample_fraction: 0.2
      optuna_storage: "sqlite:///optuna_<workflow_name>.db"
      optuna_study_name: "<workflow_name>_local"
  train_model:
    # Rename this key to match your training step function name (e.g. train_als)
    enable_cache: true
    parameters:
      checkpoint_path: "./checkpoints"
      n_dask_partitions: 4
      checkpoint_val_every_n_epochs: 5
  compute_metrics:
    enable_cache: true
    parameters:
      top_k: 10
  register_model:
    enable_cache: false
    parameters:
      rmse_threshold: 1.0
      checkpoint_path: "./checkpoints"
  generate_batch_recommendations:
    enable_cache: false
    parameters:
      batch_top_k: 50
  check_retrain_trigger:
    enable_cache: false
    parameters:
      drift_threshold_n_features: 2
      max_age_days: 30
