# ZenML pipeline run config — AWS production
# Used with: python run.py run --workflow <workflow_name> --pipeline training --config workflows/<workflow_name>/configs/aws.yaml --stack aws_stack
# Same structure as local.yaml with production-scale overrides.
enable_cache: true
enable_step_logs: true
enable_artifact_metadata: True
enable_artifact_visualization: True

# ── Pipeline-level infrastructure settings ────────────────────────────────────
settings:
  resources:
    cpu_count: 1
    gpu_count: 0
    memory: "1GB"
  docker:
    dockerfile: "docker/pipeline/Dockerfile"

parameters:
  # Pipeline-level overrides for AWS production scale
  rank: 100
  regularization: 0.01
  alpha: 1.0
  n_iter: 20
  enable_hpo: true


# ── Step-level settings ───────────────────────────────────────────────────────
steps:
  ingest_data:
    enable_cache: true
    parameters:
      dataset_size: "full"
      n_dask_partitions: 64
    resources:
      cpu_count: 2
      gpu_count: 0
      memory: "4GB"
  validate_data:
    enable_cache: true
    parameters:
      min_sparsity: 0.95
      min_ratings: 20000000
  build_encoders:
    enable_cache: true
  split_data:
    enable_cache: true
    parameters:
      train_ratio: 0.8
      val_ratio: 0.1
      test_ratio: 0.1
  run_hpo:
    enable_cache: false
    parameters:
      hpo_n_trials: 200
      hpo_subsample_fraction: 0.2
      optuna_storage: "${OPTUNA_STORAGE}"  # PostgreSQL connection string via env var
      optuna_study_name: "<workflow_name>_prod"
  train_model:
    # Rename this key to match your training step function name (e.g. train_als)
    enable_cache: true
    parameters:
      checkpoint_path: "s3://aips-zenml-checkpoints"
      n_dask_partitions: 64
      checkpoint_val_every_n_epochs: 5
    resources:
      cpu_count: 4
      gpu_count: 1
      memory: "16GB"
  compute_metrics:
    enable_cache: true
    parameters:
      top_k: 10
  register_model:
    enable_cache: false
    parameters:
      rmse_threshold: 1.0
      checkpoint_path: "s3://aips-zenml-checkpoints"
  generate_batch_recommendations:
    enable_cache: false
    parameters:
      batch_top_k: 50
      batch_output_path: "s3://aips-zenml-predictions/batch/<workflow_name>"
      dynamodb_table: "<workflow_name>-recommendations"
  run_drift_detection:
    enable_cache: false
    parameters:
      monitoring_output_path: "s3://aips-zenml-predictions/monitoring/<workflow_name>"
  check_retrain_trigger:
    enable_cache: false
    parameters:
      drift_threshold_n_features: 2
      max_age_days: 30
