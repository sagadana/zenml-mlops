"""FastAPI recommendation service. Model loaded once at startup via lifespan."""
from __future__ import annotations
import json, logging, os, time
from contextlib import asynccontextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional
import cloudpickle
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field
from workflows.<workflow_name>.models.<workflow_name>_model import <ModelClassName>

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

MODEL_PATH = os.environ.get("MODEL_PATH", "model/<workflow_name>_model.pkl")
LOG_PATH = os.environ.get("LOG_PATH", "logs/inference.jsonl")
LOG_ENABLED = os.environ.get("LOG_ENABLED", "true").lower() == "true"
_model: Optional[<ModelClassName>] = None


@asynccontextmanager
async def lifespan(app: FastAPI):
    global _model
    with open(MODEL_PATH, "rb") as f:
        _model = cloudpickle.load(f)
    logger.info("Model loaded: %s", _model)
    yield
    _model = None


app = FastAPI(title="<WorkflowName> Recommender", version="1.0.0", lifespan=lifespan)


class PredictRequest(BaseModel):
    user_id: int = Field(..., ge=0)
    top_k: int = Field(10, ge=1, le=200)


class PredictResponse(BaseModel):
    user_id: int
    recommendations: list[dict]
    model_version: str
    latency_ms: float


@app.get("/health")
async def health():
    if _model is None:
        raise HTTPException(status_code=503, detail="Model not loaded")
    return {"status": "ok", "model_version": _model.model_version,
            "n_users": _model.n_users, "n_items": _model.n_items}


@app.post("/recommend", response_model=PredictResponse)
async def recommend(request: PredictRequest):
    if _model is None:
        raise HTTPException(status_code=503, detail="Model not loaded")
    t0 = time.perf_counter()
    try:
        recs = _model.predict(request.user_id, top_k=request.top_k)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Unknown user_id: {request.user_id}")
    latency_ms = (time.perf_counter() - t0) * 1000
    if LOG_ENABLED:
        _write_log(request.user_id, request.top_k, latency_ms)
    return PredictResponse(user_id=request.user_id, recommendations=recs,
                           model_version=_model.model_version, latency_ms=round(latency_ms, 2))


def _write_log(user_id: int, top_k: int, latency_ms: float) -> None:
    try:
        entry = json.dumps({"timestamp": datetime.now(timezone.utc).isoformat(),
                            "user_id": user_id, "top_k": top_k, "latency_ms": round(latency_ms, 2)})
        log_file = Path(LOG_PATH)
        log_file.parent.mkdir(parents=True, exist_ok=True)
        with open(log_file, "a") as f:
            f.write(entry + "\n")
    except Exception as exc:
        logger.warning("Log write failed: %s", exc)
