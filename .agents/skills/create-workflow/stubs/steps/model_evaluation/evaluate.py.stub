"""ZenML step: compute_metrics — evaluate model on held-out test set."""
from __future__ import annotations
import logging
from typing import Annotated
import dask.dataframe as dd
import numpy as np
from zenml import step

logger = logging.getLogger(__name__)


@step(enable_cache=True)
def compute_metrics(
    test_data: dd.DataFrame,
    primary_weights: np.ndarray,
    secondary_weights: np.ndarray,
    best_hyperparams: dict,
    top_k: int = 10,
) -> Annotated[dict, "eval_metrics"]:
    """
    Compute offline metrics. At minimum return {"rmse": float, f"ndcg_at_{top_k}": float}.
    Log all float metrics + hyperparams to MLflow if the tracker is active.
    """
    metrics: dict = {}
    # TODO: implement metric computation (RMSE, NDCG@K, Precision@K, etc.)
    try:
        import mlflow
        mlflow.log_metrics({k: v for k, v in metrics.items() if isinstance(v, float)})
        mlflow.log_params(best_hyperparams)
    except Exception as exc:
        logger.warning("MLflow logging skipped: %s", exc)
    return metrics
