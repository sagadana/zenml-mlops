"""ZenML step: split_data — stratified per-user temporal train/val/test split."""
from __future__ import annotations
import logging
from typing import Annotated, Tuple
import dask_expr as dd
import pandas as pd
from zenml import step
from workflows.<workflow_name>.materializers.dask_dataframe_materializer import DaskDataFrameMaterializer

logger = logging.getLogger(__name__)


@step(enable_cache=True, output_materializers={
    "train_data": DaskDataFrameMaterializer,
    "val_data": DaskDataFrameMaterializer,
    "test_data": DaskDataFrameMaterializer,
})
def split_data(
    raw_data: dd.DataFrame,
    user_encoder: pd.Series,
    item_encoder: pd.Series,
    train_ratio: float = 0.8,
    val_ratio: float = 0.1,
    test_ratio: float = 0.1,
) -> Tuple[
    Annotated[dd.DataFrame, "train_data"],
    Annotated[dd.DataFrame, "val_data"],
    Annotated[dd.DataFrame, "test_data"],
]:
    """
    Stratified per-user temporal split (older ratings → train, newer → val/test).
    Apply encoders to produce integer-indexed (user_idx, item_idx, rating) DataFrames.
    """
    assert abs(train_ratio + val_ratio + test_ratio - 1.0) < 1e-6
    # TODO: implement sort-by-timestamp per user, proportional assignment, encoder application
    raise NotImplementedError
