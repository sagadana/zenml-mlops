"""ZenML step: validate_data — assert data quality before training."""
from __future__ import annotations
import logging
from typing import Annotated
import dask.dataframe as dd
from zenml import step

logger = logging.getLogger(__name__)


class DataValidationError(Exception):
    """Raised when the dataset fails a quality assertion. Halts the pipeline."""


@step(enable_cache=True)
def validate_data(
    raw_data: dd.DataFrame,
    min_rows: int = 100_000,
) -> Annotated[dict, "validation_report"]:
    """
    Run data quality assertions. Raise DataValidationError if any check fails.
    Checks to implement: no nulls, value ranges, no duplicate primary keys, min row count.
    Returns a report dict with counts and statistics.
    """
    errors: list[str] = []
    # TODO: implement checks
    if errors:
        raise DataValidationError("\n".join(errors))
    return {"status": "ok", "n_rows": len(raw_data)}
