"""ZenML step: train_model — distributed training with epoch-level checkpointing."""
from __future__ import annotations
import logging, os, uuid
from typing import Annotated, Tuple
import dask.dataframe as dd
import numpy as np
from zenml import get_step_context, step
from helpers.checkpointing import load_latest_checkpoint, save_checkpoint
from helpers.dask_cluster import get_dask_client, get_client_mode_from_config

logger = logging.getLogger(__name__)


@step(enable_cache=True)
def train_model(
    train_data: dd.DataFrame,
    val_data: dd.DataFrame,
    best_hyperparams: dict,
    checkpoint_path: str = "./checkpoints",
    n_dask_partitions: int = 4,
    checkpoint_val_every_n_epochs: int = 5,
) -> Tuple[
    Annotated[np.ndarray, "primary_weights"],
    Annotated[np.ndarray, "secondary_weights"],
]:
    """
    Train with distributed Dask workers and epoch-level checkpointing.

    RESUMABILITY:
      - First run: initializes weights randomly, trains from epoch 0
      - Restart after failure: loads latest .done checkpoint, resumes from next epoch
      - ZenML cache (enable_cache=True): skips entirely if code + inputs unchanged

    To resume a failed run: re-run the exact same command. No manual steps needed.
    """
    n_iter = int(best_hyperparams.get("n_iter", 15))

    # Scope checkpoints to this pipeline run so parallel runs don't collide
    try:
        run_id = get_step_context().pipeline_run.id
    except Exception:
        run_id = str(uuid.uuid4())[:8]
    run_checkpoint_path = f"{checkpoint_path}/{run_id}"

    # Load checkpoint or initialize weights from scratch
    start_epoch, primary_weights, secondary_weights = load_latest_checkpoint(run_checkpoint_path)
    if primary_weights is None:
        logger.info("No checkpoint — initializing weights")
        # TODO: replace with real initialization for this algorithm
        primary_weights = np.zeros((1,), dtype=np.float32)
        secondary_weights = np.zeros((1,), dtype=np.float32)
    else:
        logger.info("Resuming from epoch %d", start_epoch)

    # Materialize training data for partition building (done once, reused every epoch)
    train_pd = train_data.compute()

    config = {"dask_scheduler_address": os.environ.get("DASK_SCHEDULER_ADDRESS")}
    with get_dask_client(mode=get_client_mode_from_config(config)) as client:
        for epoch in range(start_epoch, n_iter):
            logger.info("Epoch %d/%d", epoch + 1, n_iter)

            # TODO: implement one distributed epoch using client.submit():
            #   futures = [client.submit(update_fn, partition, secondary_weights) for partition in partitions]
            #   primary_weights = np.vstack(client.gather(futures))

            # Save checkpoint atomically after every epoch
            save_checkpoint(epoch + 1, primary_weights, secondary_weights, run_checkpoint_path)

            # Optional: log validation metric periodically
            if checkpoint_val_every_n_epochs > 0 and (epoch + 1) % checkpoint_val_every_n_epochs == 0:
                pass  # TODO: compute val metric and log via logger.info()

    return primary_weights, secondary_weights
